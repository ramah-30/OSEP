# Root of the Laravel API.
#
# Default is a RELATIVE path (/api/v1): the Vite dev server proxies /api to the
# backend (vite.config.js -> VITE_API_PROXY_TARGET, default http://localhost:8001).
# Keeping it relative means the app calls the API on its own origin, so a single
# ngrok tunnel serves both the app and its API — no second tunnel needed.
#
# For a production build served separately from the API, set this to the API's
# absolute URL instead, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Set to true only when serving the dev server through an https tunnel (ngrok),
# so HMR reconnects over wss:443. Leave unset/false for normal localhost dev.
# VITE_TUNNEL=true

# Override if your Laravel backend runs somewhere other than localhost:8001.
# VITE_API_PROXY_TARGET=http://localhost:8001

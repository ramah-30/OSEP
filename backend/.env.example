APP_NAME=OSEP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osep
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# Set MAIL_MAILER=smtp once real credentials are filled in below.
# Until then every mail is written to storage/logs/laravel.log.
#
# Gmail   -> MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=tls
#            MAIL_USERNAME=<your@gmail.com>  MAIL_PASSWORD=<16-char App Password>
# SendGrid-> MAIL_HOST=smtp.sendgrid.net MAIL_PORT=587 MAIL_SCHEME=tls
#            MAIL_USERNAME=apikey  MAIL_PASSWORD=<SG. api key>
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@osep.app"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Google OAuth â€” https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI below.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# ---------------------------------------------------------------------------
# Africa's Talking SMS gateway. Leave AT_API_KEY blank to keep SMS disabled
# (the "Message" channel then reports as unconfigured instead of pretending to
# send). Use username "sandbox" + AT_SANDBOX=true with a sandbox key to test.
# ---------------------------------------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# ---------------------------------------------------------------------------
# Uploads (avatars/logos/venue photos). Local disk by default — fine for dev,
# but a Render (or any container-per-deploy host) disk is wiped on every
# deploy. Set FILESYSTEM_PUBLIC_DRIVER=s3 in production with a Cloudflare R2
# bucket (S3-compatible, free tier) so uploads actually persist.
# ---------------------------------------------------------------------------
FILESYSTEM_PUBLIC_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=
